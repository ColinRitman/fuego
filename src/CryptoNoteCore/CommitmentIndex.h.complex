#pragma once

#include <unordered_map>
#include <vector>
#include <map>
#include <array>
#include <optional>
#include <cstdint>
#include <mutex>
#include "crypto/hash.h"

namespace CryptoNote {

class ISerializer;

/// Type of commitment (HEAT burn or COLD deposit)
enum class CommitmentType : uint8_t {
    HEAT = 0,   // Permanent burn, term = FOREVER (0xFFFFFFFF)
    COLD = 1    // Term deposit with lock period
};

/// Fee epoch tracking for elderfier compensation (Dynamigo Phase - OLD MODEL)
/// DEPRECATED: Replaced by percentage-based elderfier consensus
/// Kept for backward compatibility
struct ElderfierEpochRewards {
    uint64_t epochNumber = 0;                        // Which epoch (0, 1, 2, ...)
    std::vector<std::string> activeElderfiers;       // Addresses of active elderfiers
    uint64_t totalFeesCollected = 0;                 // Total XFG collected during epoch
    std::map<std::string, uint64_t> distribution;    // Earned: address -> amount
    uint64_t epochStartBlock = 0;                    // First block of epoch
    uint64_t epochEndBlock = 0;                      // Last block of epoch

    // Helper method to validate epoch data
    bool isValid() const {
        return epochNumber >= 0 &&
               !distribution.empty() &&
               epochStartBlock <= epochEndBlock;
    }
};

/// Fee escrow for elderfier earnings (Percentage-Based Model - NEW)
/// Elderfiers accumulate 0.1% banking fees from deposit transactions
/// Fees are held in escrow and can be claimed at any time
/// Only elderfiers who signed the current merkle root receive fees (pro-rata)
struct ElderfierFeeEscrow {
    std::map<std::string, uint64_t> accumulatedFees;  // EF address -> accumulated XFG balance
    uint64_t lastDistributionBlock = 0;               // Block height of last fee distribution
    std::vector<std::string> currentSigningElderfiers; // EFs who signed current merkle root
    uint64_t totalFeesInEscrow = 0;                   // Total XFG in escrow (sum of all balances)

    // Helper methods
    bool isEmpty() const { return accumulatedFees.empty(); }
    uint64_t getBalance(const std::string& elderfierAddress) const {
        auto it = accumulatedFees.find(elderfierAddress);
        return it != accumulatedFees.end() ? it->second : 0;
    }
    std::string toString() const;
};

/// Cached elderfier signature (from P2P gossip)
/// Stores signatures broadcast via P2P for threshold consensus
struct CachedElderfierSignature {
    Crypto::Hash merkle_root;              // Merkle root that was signed
    Crypto::Signature signature;           // ECDSA signature
    uint8_t elderfier_id;                 // EFiD (0-255), not wallet address
    uint64_t block_height;                // Block height when signed
    uint64_t timestamp;                   // Unix timestamp when signed
    uint64_t received_block_height;       // Block height when we received this
    bool is_valid;                        // Whether signature validated against registered EF
};

/// Signature cache for merkle root consensus
/// Collects signatures from elderfiers and tracks consensus progress
struct SignatureCache {
    // Key: (elderfier_id, merkle_root_hex)
    // Value: Latest signature from this EF for this root
    // Using hex string for merkle_root since Crypto::Hash doesn't have operator<
    std::map<std::pair<uint8_t, std::string>, CachedElderfierSignature> signatures;

    // Track when each root was first seen (for flush decision)
    // Using hex string as key since Crypto::Hash doesn't have operator<
    std::map<std::string, uint64_t> root_first_seen_block;

    // Current root being collected
    Crypto::Hash current_merkle_root;
    uint64_t current_merkle_root_block = 0;  // Block height when root created
};

/// Entry in the commitment index
/// Stores all public metadata about a deposit (commitment is already public on-chain)
struct CommitmentEntry {
    Crypto::Hash commitment;      // The commitment hash (primary key)
    Crypto::Hash txHash;          // Transaction hash containing this commitment
    uint64_t blockHeight;         // Block where deposit was made
    uint64_t amount;              // Amount in atomic units
    uint32_t term;                // Term in blocks (0xFFFFFFFF for HEAT)
    CommitmentType type;          // HEAT or COLD
    uint8_t targetChainId;        // Target EVM chain (1=ETH, 42161=Arbitrum, etc.)

    void serialize(ISerializer& s);
};

/// Index of all HEAT/COLD deposit commitments
///
/// Provides O(1) lookup of deposits by commitment hash.
/// The commitment is already public (stored in tx_extra), so this index
/// doesn't leak any new information. Users query by commitment hash
/// (derived from their secret locally) without exposing the secret.
///
/// Thread-safe for concurrent access.
class CommitmentIndex {
public:
    using Height = uint64_t;

    CommitmentIndex();
    ~CommitmentIndex();

    // --- Index Management ---

    /// Add a new commitment to the index
    /// Called during block processing when 0xB4 (HEAT) or 0xCD (COLD) tag is found
    bool addCommitment(const CommitmentEntry& entry);

    /// Remove a commitment (for block rollback)
    bool removeCommitment(const Crypto::Hash& commitment);

    /// Remove all commitments at or above a given height (for chain reorganization)
    size_t rollbackToHeight(Height height);

    // --- Query Methods ---

    /// Look up a deposit by commitment hash
    /// Returns nullopt if not found
    std::optional<CommitmentEntry> getByCommitment(const Crypto::Hash& commitment) const;

    /// Check if a commitment exists in the index
    bool hasCommitment(const Crypto::Hash& commitment) const;

    /// Get all commitments (for debugging/stats)
    std::vector<CommitmentEntry> getAllCommitments() const;

    /// Get all commitments of a specific type
    std::vector<CommitmentEntry> getCommitmentsByType(CommitmentType type) const;

    /// Get commitments in a block range
    std::vector<CommitmentEntry> getCommitmentsInRange(Height fromHeight, Height toHeight) const;

    // --- Statistics ---

    /// Total number of indexed commitments
    size_t size() const;

    /// Number of HEAT commitments
    size_t heatCount() const;

    /// Number of COLD commitments
    size_t coldCount() const;

    /// Highest indexed block
    Height highestBlock() const;

    // --- Merkle Tree ---

    /// Compute the Merkle root of all commitments
    /// Used for trustless verification on EVM chains
    /// Tree is ordered by block height then commitment hash
    Crypto::Hash computeMerkleRoot() const;

    /// Generate a Merkle proof for a specific commitment
    /// Returns empty vector if commitment not found
    /// Proof format: sibling hashes from leaf to root
    std::vector<Crypto::Hash> getMerkleProof(const Crypto::Hash& commitment) const;

    /// Get the leaf index for a commitment in the Merkle tree
    /// Returns -1 if not found
    int64_t getLeafIndex(const Crypto::Hash& commitment) const;

    /// Verify a Merkle proof
    /// @param commitment The commitment to verify
    /// @param proof The Merkle proof (sibling hashes)
    /// @param root The expected Merkle root
    /// @param leafIndex The index of the commitment in the tree
    /// @return True if proof is valid
    static bool verifyMerkleProof(const Crypto::Hash& commitment,
                                   const std::vector<Crypto::Hash>& proof,
                                   const Crypto::Hash& root,
                                   size_t leafIndex);

    // --- Elderfier Fee Tracking (OLD Epoch-Based Model - Dynamigo Phase) ---

    /// Add fee collected from deposit (called during block processing)
    /// @param feeAmount: Fee in atomic XFG units
    void addElderfierFee(uint64_t feeAmount);

    /// Finalize current epoch and prepare for next one
    /// Called when blockHeight % EPOCH_DURATION_BLOCKS == 0
    /// Distributes accumulated fees to active elderfiers
    void finalizeEpoch(uint64_t currentBlockHeight);

    /// Get rewards for specific epoch
    /// @param epochNumber: Epoch number (0, 1, 2, ...)
    /// @return Epoch rewards data (empty if not found)
    ElderfierEpochRewards getEpochRewards(uint64_t epochNumber) const;

    /// Get earnings for specific elderfier in specific epoch
    /// @param elderfierAddress: Elderfier address string
    /// @param epochNumber: Epoch number
    /// @return Earned amount in atomic XFG (0 if not active)
    uint64_t getElderfierEarnings(const std::string& elderfierAddress, uint64_t epochNumber) const;

    /// Get current epoch number based on block height
    uint64_t getCurrentEpoch(uint64_t currentBlockHeight) const;

    /// Get active elderfiers for given epoch
    std::vector<std::string> getActiveElderfiers(uint64_t epochNumber) const;

    /// Register elderfier address at index
    /// Called during initialization
    void registerElderfierAddress(uint8_t index, const std::string& address);

    /// Get total fees accumulated in current epoch
    uint64_t getCurrentEpochFees() const;

    /// Get epoch history (for debugging/stats)
    std::vector<ElderfierEpochRewards> getEpochHistory() const;

    // --- Elderfier Fee Escrow (NEW Percentage-Based Model) ---

    /// Deposit fee to escrow for elderfiers (called during block validation)
    /// Splits fee pro-rata among elderfiers who signed current merkle root
    /// @param totalFee: Total 0.1% banking fee from deposit transaction
    void depositFeeToEscrow(uint64_t totalFee);

    /// Update list of elderfiers who signed current merkle root
    /// Called when merkle root is signed by elderfiers via P2P gossip
    /// @param signingElderfiers: List of elderfier addresses who signed
    void updateSigningElderfiers(const std::vector<std::string>& signingElderfiers);

    /// Get pending fee balance for specific elderfier
    /// @param elderfierAddress: Elderfier address string
    /// @return Accumulated fee balance in atomic XFG
    uint64_t getElderfierFeeBalance(const std::string& elderfierAddress) const;

    /// Claim accumulated fees (marks balance as claimed, output will be created)
    /// @param elderfierAddress: Elderfier address string
    /// @return Amount being claimed (0 if none pending)
    uint64_t claimElderfierFees(const std::string& elderfierAddress);

    /// Get total fees in escrow (debugging/stats)
    uint64_t getTotalFeesInEscrow() const;

    /// Get all elderfier fee balances (debugging/stats)
    std::map<std::string, uint64_t> getAllFeeBalances() const;

    /// Get current signing elderfiers (for percentage calculation)
    std::vector<std::string> getCurrentSigningElderfiers() const;

    /// Reset fee escrow (only for testing/debugging)
    void resetFeeEscrow();

    // --- Elderfier Signature Caching (for P2P gossip) ---

    /// Add or update signature from elderfier (called when P2P message received)
    /// @param sig: Signature info to cache
    void addSignatureToCache(const CachedElderfierSignature& sig);

    /// Get all valid signatures for current merkle root
    /// @return Vector of signatures from elderfiers who signed current root
    std::vector<CachedElderfierSignature> getSignaturesForCurrentRoot();

    /// Get signatures for specific merkle root (may be old/flushed)
    /// @param root: Merkle root to query
    /// @return Vector of signatures for that root
    std::vector<CachedElderfierSignature> getSignaturesForRoot(const Crypto::Hash& root);

    /// Get count of signatures for current merkle root
    /// @return Number of valid signatures received
    size_t getSignatureCountForCurrentRoot() const;

    /// Calculate consensus percentage for current merkle root
    /// @return Percentage of registered EFs who have signed (0-100)
    uint64_t getConsensusPercentageForCurrentRoot() const;

    /// Get list of elderfiers who signed current merkle root
    /// @return Vector of elderfier addresses
    std::vector<std::string> getSignedElderfiers() const;

    /// Get list of elderfiers who haven't signed current merkle root
    /// @return Vector of elderfier addresses not yet signed
    std::vector<std::string> getPendingElderfiers() const;

    /// Check if ≥60% of elderfiers have signed (small deposit threshold)
    /// @return True if 60% threshold met
    bool meets60PercentThreshold() const;

    /// Check if ≥80% of elderfiers have signed (large deposit threshold)
    /// @return True if 80% threshold met
    bool meets80PercentThreshold() const;

    /// Update current merkle root being collected (resets signature collection)
    /// @param new_root: New merkle root hash
    void updateCurrentMerkleRoot(const Crypto::Hash& new_root);

    /// Flush old signatures when threshold met (auto-called on consensus)
    /// Clears cache and prepares for next merkle root
    void flushOldSignatures();

    /// Cleanup expired signatures older than 600 blocks
    /// @param current_block_height: Current block height for age calculation
    void cleanupExpiredSignatures(uint64_t current_block_height);

    /// Check if threshold met and auto-flush if needed (called per block)
    /// @param current_block_height: Current block height
    void checkAndFlushThreshold(uint64_t current_block_height);

    // --- Persistence ---

    /// Serialize index to storage
    void serialize(ISerializer& s);

    /// Clear all entries
    void clear();

private:
    mutable std::mutex m_mutex;

    // Primary index: commitment hash -> entry
    std::unordered_map<Crypto::Hash, CommitmentEntry> m_commitments;

    // Secondary index: block height -> list of commitments (for rollback)
    std::unordered_map<Height, std::vector<Crypto::Hash>> m_byHeight;

    // Statistics
    size_t m_heatCount;
    size_t m_coldCount;
    Height m_highestBlock;

    // --- Elderfier Fee Tracking (OLD Epoch-Based Model) ---

    // Epoch-based fee distribution
    std::vector<ElderfierEpochRewards> m_epochHistory;
    uint64_t m_currentEpochStartBlock = 0;
    uint64_t m_currentEpochTotalFees = 0;
    uint64_t m_currentBlockHeight = 0;

    // Epoch configuration constants (used only for old rotation-based model)
    static constexpr uint64_t EPOCH_DURATION_BLOCKS = 1234;       // ~7 days (480s * 1234 blocks ≈ 6.9 days)
    static constexpr uint8_t TOTAL_ELDERFIERS = 5;                // OLD: fixed 5 elderfiers
    static constexpr uint8_t ACTIVE_ELDERFIERS_PER_EPOCH = 3;     // OLD: 3 active per epoch

    // Deterministic rotation schedule (hard-coded for old MVP)
    // Format: activeElderfiers[epochNumber % 5] gives active 3 for that epoch
    std::array<std::vector<uint8_t>, 5> m_rotationSchedule = {{
        {1, 2, 3},    // Epoch 0: Elderfiers 1, 2, 3 active
        {2, 3, 4},    // Epoch 1: Elderfiers 2, 3, 4 active
        {3, 4, 5},    // Epoch 2: Elderfiers 3, 4, 5 active
        {4, 5, 1},    // Epoch 3: Elderfiers 4, 5, 1 active
        {5, 1, 2}     // Epoch 4: Elderfiers 5, 1, 2 active
    }};

    // Elderfier addresses (map from index to address)
    std::map<uint8_t, std::string> m_elderfierAddresses;

    // --- Elderfier Fee Escrow (NEW Percentage-Based Model) ---

    // Fee escrow for unlimited elderfiers
    ElderfierFeeEscrow m_feeEscrow;

    // NEW thresholds for percentage-based consensus
    static constexpr uint8_t SMALL_DEPOSIT_THRESHOLD_PERCENT = 60;  // Small deposits (0.8 & 8 XFG): need 60% consensus
    static constexpr uint8_t LARGE_DEPOSIT_THRESHOLD_PERCENT = 80;  // Large deposits (80 & 800 XFG): need 80% consensus

    // Merkle root signing information
    std::vector<uint8_t> m_currentMerkleRootSigners;      // EFiDs (0-255) of registered elderfiers
    Crypto::Hash m_lastMerkleRoot;                         // Last computed merkle root

    // --- Elderfier Signature Cache (P2P Gossip) ---

    // Signature cache for merkle root consensus
    SignatureCache m_signatureCache;

    // Expiry configuration
    static constexpr uint64_t SIGNATURE_MAX_AGE_BLOCKS = 600;  // Keep signatures for up to 600 blocks

    // Private helper methods
    uint64_t calculateCurrentEpoch(Height blockHeight) const;
    void finalizeEpochImpl();
    void distributeFeesProRata(uint64_t totalFee);  // NEW: distribute to signing EFs
};


    // --- 0xE8 Deposit Registration Tracking ---
    
    struct PendingElderfierStake {
        uint64_t deposit_count = 0;      // Count of 0xE8 deposits seen from this wallet
        uint64_t total_amount = 0;       // Total XFG deposited (should reach 4000*COIN for registration)
        Crypto::PublicKey signing_pubkey; // ECDSA public key (set when we see it in tx)
    };
    
    // Track pending stakes by wallet address
    std::map<std::string, PendingElderfierStake> m_pendingElderfierStakes;
    
    // Helper method to extract wallet address from transaction
    std::string getWalletAddressFromTx(const Crypto::Hash& txHash);

    // Helper method to check if deposit is 0xE8 type
    bool isElderfierRegistrationDeposit(const CommitmentEntry& entry);
    
    // Helper method to attempt elderfier registration
    bool tryRegisterElderfier(const std::string& wallet, const Crypto::PublicKey& pubkey);
} // namespace CryptoNote
