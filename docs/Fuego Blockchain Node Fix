        else if (field.type() == typeid(TransactionExtraCDDepositSecret)) {
          res.hasCommitment = true;
          res.commitmentType = 0xCD; // 205
          break;
        }
      }
    }
  }

  res.status = "found";
  res.errorMessage = "";
  return true;
}

