template<typename K, typename Hash>
bool serialize(phmap::flat_hash_set<K, Hash>& value, Common::StringView name, CryptoNote::ISerializer& serializer) {
  size_t size = value.size();
  if (!serializer.beginArray(size, name)) {
    return false;
  }

  if (serializer.type() == ISerializer::OUTPUT) {
    for (auto& key : value) {
      serializer(const_cast<K&>(key), "");
    }
  } else {
    value.reserve(size);
    while (size--) {
      K key;
      serializer(key, "");
      value.insert(key);
    }
  }

  return serializer.endArray();
}

